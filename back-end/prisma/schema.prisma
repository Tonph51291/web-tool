datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  USDT
}

enum PaymentStatus {
  SUBMITTED
  VERIFIED
  REJECTED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(USER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders    Order[]

  @@map("users")
}

model Tool {
  id               String        @id @default(uuid())
  name             String
  slug             String        @unique
  shortDescription String        @map("short_description")
  description      String        @db.Text
  iconUrl          String?       @map("icon_url")
  isActive         Boolean       @default(true) @map("is_active")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  packages         ToolPackage[]
  orders           Order[]

  @@map("tools")
}

model ToolPackage {
  id           String   @id @default(uuid())
  toolId       String   @map("tool_id")
  name         String
  durationDays Int?     @map("duration_days") // null = Lifetime
  price        Int      // Price in VND or integer unit
  currency     String   @default("VND")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tool         Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@map("tool_packages")
}

model Order {
  id           String        @id @default(uuid())
  orderCode    String        @unique @map("order_code")
  userId       String        @map("user_id")
  toolId       String        @map("tool_id")
  packageId    String        @map("package_id")
  amount       Int           // Inflexible price calculated strictly from database ToolPackage
  currency     String        @default("VND")
  status       OrderStatus   @default(PENDING_PAYMENT)
  note         String?       @db.Text
  keyDelivered String?       @map("key_delivered") @db.Text
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  tool         Tool          @relation(fields: [toolId], references: [id], onDelete: Restrict)
  package      ToolPackage   @relation(fields: [packageId], references: [id], onDelete: Restrict)
  paymentProofs PaymentProof[]

  @@map("orders")
}

model PaymentProof {
  id              String        @id @default(uuid())
  orderId         String        @map("order_id")
  paymentMethod   PaymentMethod @map("payment_method")
  transactionRef  String?       @map("transaction_ref")
  proofImagePath  String        @map("proof_image_path")
  amountReported  Int?          @map("amount_reported")
  status          PaymentStatus @default(SUBMITTED)
  adminNote       String?       @map("admin_note") @db.Text
  verifiedAt      DateTime?     @map("verified_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payment_proofs")
}
